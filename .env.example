# Example Environment Configuration (DO NOT COMMIT REAL SECRETS)
# Database Connection (PostgreSQL in production, SQLite for local zero-dependency testing)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/facesimilarity?schema=public"

# Authentication Security
JWT_SECRET="replace-with-a-64-character-random-hex-string"
ADMIN_REGISTRATION_SECRET="replace-with-secure-admin-provisioning-token"

# Microservices Communication
AI_SERVICE_INTERNAL_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_AI_SERVICE_URL="http://127.0.0.1:8000"

# Application Settings
NODE_ENV="production"
PORT=3000
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TEMP_DIR="./uploads_temp"

