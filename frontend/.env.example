# ==============================================================================
# AI Face Similarity Analyzer — Frontend Environment Configuration
# ==============================================================================

# Supabase Integration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key-here"
DATABASE_URL="https://your-project-id.supabase.co"

# Python AI Inference Microservice
# LOCAL:      http://127.0.0.1:8000
# PRODUCTION: https://ai-face-similarity-backend.onrender.com  (your Render URL)
AI_SERVICE_URL="https://your-render-service.onrender.com"
AI_SERVICE_INTERNAL_URL="https://your-render-service.onrender.com"
NEXT_PUBLIC_AI_SERVICE_URL="https://your-render-service.onrender.com"

# Application Settings
NEXT_PUBLIC_APP_URL="https://your-netlify-site.netlify.app"
NODE_ENV="production"
PORT=3000
MAX_UPLOAD_SIZE_MB=10
