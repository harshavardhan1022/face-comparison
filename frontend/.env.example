# ==============================================================================
# AI Face Similarity Analyzer — Frontend Environment Template
# ==============================================================================

# Database Connection (PostgreSQL for Production, or SQLite file:./dev.db for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/face_similarity?schema=public"

# Cryptographic Session Secrets
JWT_SECRET="generate-a-secure-64-character-random-hex-string-for-production"
ADMIN_REGISTRATION_SECRET="secure-admin-bootstrap-secret-key"

# Python AI Inference Microservice URL
NEXT_PUBLIC_AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_INTERNAL_URL="http://127.0.0.1:8000"

# Application Environment
NODE_ENV="production"
COOKIE_SECURE="false" # Set to "true" when running on HTTPS / SSL domain

# Optional Email Service for Password Resets (Resend or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@facialsimilarity.ai"

# Upload Limits
MAX_UPLOAD_SIZE_MB="10"

