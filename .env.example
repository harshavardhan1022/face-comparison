# ==============================================================================
# AI Face Similarity Analyzer — Environment Configuration
# Next.js App Router + Supabase + Python AI Inference Microservice
# ==============================================================================

# 1. Supabase Project Configuration (Direct Supabase Native Cloud Integration)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"

# Supabase Server-Side Secret Key (Service Role) - NEVER EXPOSE TO CLIENT
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key-here"

# PostgreSQL Direct Connection URL
DATABASE_URL="https://your-project-id.supabase.co"

# 2. Python AI Inference Microservice
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_INTERNAL_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_SECRET="ai-worker-cluster-secret-key-2026"

# 3. Application Domain & Production Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
PORT=3000

# 4. Storage & Processing Constraints
MAX_UPLOAD_SIZE_MB=10

# 5. Optional Email Provider
EMAIL_PROVIDER_API_KEY=""
