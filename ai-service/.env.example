# ==============================================================================
# AI Face Similarity — Python Inference Service Environment
# ==============================================================================
# These are set in Render Dashboard → Environment Variables

# Server config (Render sets PORT automatically — do NOT hardcode it)
# AI_SERVICE_HOST is not needed; Render uses $PORT directly
ENVIRONMENT=production

# CORS — comma-separated list of your Netlify frontend URLs
# Example: CORS_ORIGINS=https://your-site.netlify.app,https://your-custom-domain.com
CORS_ORIGINS=https://your-netlify-site.netlify.app
